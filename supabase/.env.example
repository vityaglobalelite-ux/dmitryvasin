# Secrets for Edge Functions (set via `supabase secrets set` or self-hosted env)

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Цены по умолчанию — в таблице tariff_prices (см. bot/sql/005_tariff_prices.sql).
# Env ниже только fallback, если строки в БД нет:
# STRIPE_CURRENCY=eur
# STRIPE_AMOUNT_TRIAL=4900
# STRIPE_PRICE_TRIAL=price_...

CHECKOUT_SECRET=same-as-bot-CHECKOUT_SECRET

# Usually injected by Supabase runtime:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SUCCESS_URL=https://t.me/YOUR_BOT_USERNAME
STRIPE_CANCEL_URL=https://t.me/YOUR_BOT_USERNAME

# Catalog site Stripe — TEST only. Never STRIPE_SECRET_KEY (bot / live VPS).
# sk_live_ is rejected in catalog-create-checkout and catalog-stripe-webhook.
CATALOG_STRIPE_SECRET_KEY=sk_test_...
# Do not reuse STRIPE_WEBHOOK_SECRET (bot). Catalog webhook:
STRIPE_CATALOG_WEBHOOK_SECRET=whsec_...
CATALOG_STRIPE_SUCCESS_URL=
CATALOG_STRIPE_CANCEL_URL=

# Catalog origin allowlist for kinescope-token (comma-separated, no trailing slash).
# Localhost / 127.0.0.1 are always allowed. Example: https://dmitryvasin.com
# CATALOG_PUBLIC_ORIGIN=https://dmitryvasin.com

# Catalog support relay (Wave 6A). Same bot as bot-support — do not invent a second token.
# catalog-relay-support sends tickets to admins; inbound replies stay in bot-support.
# SUPPORT_BOT_TOKEN=
# TELEGRAM_SUPPORT_BOT_TOKEN=
# Fallback: TELEGRAM_BOT_TOKEN (same name as bot-support).
# CATALOG_SUPPORT_ADMIN_IDS=123456789,987654321
# Fallback: ADMIN_TELEGRAM_IDS

# Kinescope (Wave 5B). Dashboard → Settings → API tokens (UUID Bearer).
# kinescope-token: GET https://api.kinescope.io/v1/videos/:id, then
# { embedUrl } = https://kinescope.io/embed/{id}?drmauthtoken={JWT}&preload=0
# Never NEXT_PUBLIC_. Download UI stays off (player template default).
KINESCOPE_API_TOKEN=
KINESCOPE_PROJECT_ID=
# HMAC secret for iframe drmauthtoken JWT. If empty, signed with KINESCOPE_API_TOKEN.
# KINESCOPE_PLAYBACK_JWT_SECRET=
# Optional player template id (keep «Download video» disabled in the template).
# KINESCOPE_PLAYER_ID=
